  "cards": [
    {
      "dot": "emerald",
      "title": "The rule, and the test that enforces it",
      "items": [
        "Engine never imports game. sim-core never imports the renderer.",
        "The renderer depends on sim-core for logic and the message contract",
        "This is checked by a test, not by convention — which is why it has held"
      ]
    },
    {
      "dot": "cyan",
      "title": "Sim and render are separated by a transport",
      "items": [
        "Farm hosts its sim in a Node process and speaks WebSocket frames",
        "The in-browser Worker is gone; SimClient's public API was preserved",
        "The other three games still run their sim in a Web Worker"
      ]
    },
    {
      "dot": "amber",
      "title": "Determinism is the point",
      "items": [
        "sim-core is Node-safe and browser-safe, so the same tick runs in a test",
        "WASM artifacts are committed, so a fresh clone runs without build-wasm",
        "One sim per connection, with drop-stale snapshot backpressure"
      ]
    }
  ]
