# infrastructure/.env — read by docker-compose.yml's `env_file:`.
#
# COPY THIS FILE to `infrastructure/.env` and fill it in. `.env` is gitignored
# (`.env.example` is the one exception); never commit a real value here.
#
# The compose file references `.env` unconditionally, so `docker compose up`
# fails without it even though every variable below has a default.

# Port the Farm Valley sim server listens on INSIDE the container, and the
# loopback port compose publishes it on. Read by games/farm/server/src/index.ts
# (`process.env["PORT"] ?? 8787`) and defaulted again in the Dockerfile's ENV.
# Change it only if 8787 collides on the host — Caddy's upstream must match.
PORT=8787

# The image's Dockerfile already sets NODE_ENV=production. Setting it here too
# is redundant, but listed so the effect is discoverable: in production the
# server EXITS if the wasm pathfinder fails to load, instead of warning and
# degrading to the JS pathfinder (audit-40, games/farm/server/src/index.ts).
# NODE_ENV=production
