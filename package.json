{
  "name": "game-engine-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "engine/*",
    "games/*/*",
    "tools/*",
    "docs",
    "portal"
  ],
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w @farm/client",
    "dev:citadel": "npm run dev -w @citadel/client",
    "citadel": "node scripts/dev.mjs citadel",
    "farm": "node scripts/dev.mjs farm",
    "hollow": "npm run dev -w @hollow/client",
    "mathquest": "npm run dev -w @mathquest/client",
    "portal": "npm run dev -w @game-engine/portal",
    "build": "npm run build -w @farm/client",
    "test": "turbo run test --continue=always --concurrency=1",
    "typecheck": "turbo run typecheck --continue=always",
    "lint": "eslint . --max-warnings 3573",
    "gates": "node scripts/gates.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm run test",
    "check:fast": "npm run typecheck && node scripts/check-fast.mjs",
    "check:conventions": "depcruise \"engine/*/src\" \"games/*/*/src\" \"tools/*/src\" portal/src && node vendor/house-style/bin/check-base-ui.mjs && node vendor/house-style/bin/check-structure.mjs",
    "atlas": "npm run build -w @tool/atlas-builder",
    "sim": "npm start -w @tool/run-sim",
    "sim:citadel": "npm start -w @tool/citadel-sim",
    "sim:hollow": "npm start -w @tool/hollow-sim",
    "server": "npm start -w @farm/server",
    "server:citadel": "npm start -w @citadel/server",
    "preview": "npm start -w @tool/world-preview",
    "build-wasm": "npm run build -w @engine/wasm-modules",
    "build-engine": "npm run build -w @engine/core",
    "build-ui": "npm run build -w @engine/ui",
    "pack-smoke": "mkdir -p examples/library-consumer/tarballs && npm pack -w @engine/core --pack-destination examples/library-consumer/tarballs && npm pack -w @engine/ui --pack-destination examples/library-consumer/tarballs && npm pack -w @engine/wasm-modules --pack-destination examples/library-consumer/tarballs && rm -rf examples/library-consumer/node_modules && npm install --package-lock=false --prefix examples/library-consumer && npm run smoke --prefix examples/library-consumer",
    "docs": "turbo run docs",
    "docs:dev": "npm run dev -w @game-engine/docs-site",
    "codegraph:init": "codegraph init && codegraph telemetry off && codegraph status",
    "codegraph:sync": "codegraph sync",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
